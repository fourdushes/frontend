{
  "expo": {
    "name": "HearO",
    "slug": "hearo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tohear.hearo",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "기관 사용자의 진료 음성을 기록하고 텍스트로 변환하기 위해 마이크를 사용합니다."
      }
    },
    "android": {
      "package": "com.tohear.hearo",
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": ["expo-audio"]
  }
}
